# AI Interview Assistant (Ollama Edition) — Environment Configuration

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192

# ── Vector Database ───────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/embeddings

# ── SQLite Database ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./database/interview_history.db

# ── File Storage ──────────────────────────────────────────────────────────────
RESUME_UPLOAD_DIR=./data/resumes
TRANSCRIPT_DIR=./data/transcripts
REPORT_DIR=./data/reports

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=AI Interview Assistant (Ollama)
APP_ENV=development
LOG_LEVEL=INFO
MAX_RESUME_SIZE_MB=10
SESSION_TIMEOUT_MINUTES=60
